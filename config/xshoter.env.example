# Xshoter Control runtime configuration
XSHOTER_PORT=9100
XSHOTER_DB_FILE=/var/lib/xshoter-control/control.db
XSHOTER_WEB_DIR=/opt/xshoter-control/web
XSHOTER_AGENT_SOCKET=/run/xshoter-agent.sock
XSHOTER_STATE_DIR=/var/lib/xshoter-control
XSHOTER_SETUP_TOKEN_FILE=/var/lib/xshoter-control/setup.token

# Address used by newly generated Nginx website vhosts.
# Examples: 80, 0.0.0.0:80, 10.0.0.10:80
XSHOTER_WEB_LISTEN=80

# Optional Cloudflare DNS integration.
# Leave blank to disable DNS management in the panel.
XSHOTER_CF_ZONE_ID=
XSHOTER_CF_ZONE_NAME=
XSHOTER_CF_TOKEN_FILE=/etc/xshoter-control/cloudflare.token
